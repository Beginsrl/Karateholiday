---
const parsedUrl = new URL(Astro.request.url);
---

<div class="registration-form-container">
    <form
        class="registration-form"
        action="/api/submit-registration.php"
        method="POST"
        enctype="multipart/form-data"
    >
        {
            parsedUrl.searchParams.has("success") && (
                <div class="alert success">
                    <strong>Iscrizione Inviata!</strong> Grazie per esserti
                    registrato. Riceverai una email di conferma a breve.
                </div>
            )
        }
        {
            parsedUrl.searchParams.has("error") && (
                <div class="alert error">
                    <strong>Errore!</strong> C'è stato un problema durante
                    l'invio. Riprova più tardi.
                </div>
            )
        }

        <!-- Step 1: Scelta Soggiorno -->
        <div class="form-section">
            <h3 class="form-section-title">1. Conferma pagamento anticipo</h3>
            <p class="form-note">
                Effettua il pagamento dell'anticipo di 275,00 € entro il 30
                maggio al seguente IBAN: IT59S0538777860000000505023 intestato a
                Villaggio Costa d'Argento SRL.
            </p>

            <div class="form-group">
                <label for="ricevuta">Allegare Ricevuta Pagamento</label>
                <input
                    type="file"
                    id="ricevuta"
                    name="ricevuta"
                    accept=".pdf,.jpg,.jpeg,.png"
                />
            </div>
        </div>

        <!-- Step 2: Dati Partecipante -->
        <div class="form-section">
            <h3 class="form-section-title">2. Dati Partecipante</h3>

            <div class="form-group">
                <label>Tipologia *</label>
                <select id="tipologia" name="tipologia" required>
                    <option value="" disabled selected
                        >Seleziona una tipologia</option
                    >
                    <option value="accompagnatore_0-2"
                        >Accompagnatore (non atleta) 0-2 anni</option
                    >
                    <option value="accompagnatore_3-7"
                        >Accompagnatore (non atleta) 3-7 anni</option
                    >
                    <option value="accompagnatore_8+"
                        >Accompagnatore (non atleta) 8 anni in su</option
                    >
                    <option value="allievo">Allievo</option>
                    <option value="tecnico">Tecnico</option>
                </select>
                <div id="tipologia-info" class="info-box hidden"></div>
            </div>

            <div class="form-group hidden" id="atleta-accompagnato-group">
                <label for="atleta_accompagnato"
                    >Nome Atleta Accompagnato *</label
                >
                <input
                    type="text"
                    id="atleta_accompagnato"
                    name="atleta_accompagnato"
                />
            </div>
            <div class="row-1">
                <div class="form-group">
                    <label for="email">Email (per conferma iscrizione) *</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        placeholder="tuamail@esempio.com"
                    />
                </div>
            </div>

            <div class="row-2">
                <div class="form-group">
                    <label for="cognome">Cognome *</label>
                    <input type="text" id="cognome" name="cognome" required />
                </div>
                <div class="form-group">
                    <label for="nome">Nome *</label>
                    <input type="text" id="nome" name="nome" required />
                </div>
            </div>

            <div class="row-2">
                <div class="form-group">
                    <label for="cf">Codice Fiscale *</label>
                    <input type="text" id="cf" name="cf" required />
                </div>
                <div class="form-group">
                    <label for="data_nascita">Data di Nascita *</label>
                    <input
                        type="date"
                        id="data_nascita"
                        name="data_nascita"
                        required
                    />
                </div>
            </div>

            <div class="form-group">
                <label for="luogo_nascita">Luogo di Nascita *</label>
                <input
                    type="text"
                    id="luogo_nascita"
                    name="luogo_nascita"
                    required
                />
            </div>

            <div class="form-group">
                <label for="indirizzo">Indirizzo di Residenza *</label>
                <input type="text" id="indirizzo" name="indirizzo" required />
            </div>
        </div>

        <!-- Step 3: Dati Tecnici -->
        <div class="form-section">
            <h3 class="form-section-title">3. Dati Tecnici & Note</h3>

            <div class="form-group">
                <label>Specialità della Disciplina *</label>
                <div class="checkbox-group-grid">
                    <label class="checkbox-container">
                        <input type="checkbox" name="specialita" value="kata" />
                        <span class="checkmark"></span>
                        Kata
                    </label>
                    <label class="checkbox-container">
                        <input
                            type="checkbox"
                            name="specialita"
                            value="kumite"
                        />
                        <span class="checkmark"></span>
                        Kumite
                    </label>
                    <label class="checkbox-container">
                        <input
                            type="checkbox"
                            name="specialita"
                            value="tradizionale"
                        />
                        <span class="checkmark"></span>
                        Karate Tradizionale
                    </label>
                    <label class="checkbox-container">
                        <input
                            type="checkbox"
                            name="specialita"
                            value="accompagnatore"
                        />
                        <span class="checkmark"></span>
                        Accompagnatore
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label for="allergie"
                    >Allergie Alimentari e Farmaci * (Se nessuna, scrivere
                    "Nessuna")</label
                >
                <textarea id="allergie" name="allergie" rows="2" required
                ></textarea>
            </div>

            <div class="form-group">
                <label for="peso_altezza"
                    >Peso e Altezza (Solo Stagisti) - Altrimenti
                    "Accompagnatore" *</label
                >
                <input
                    type="text"
                    id="peso_altezza"
                    name="peso_altezza"
                    required
                />
            </div>

            <div class="form-group">
                <label for="associazione"
                    >Associazione Sportiva e Nome Tecnico *</label
                >
                <textarea
                    id="associazione"
                    name="associazione"
                    rows="2"
                    required></textarea>
            </div>

            <div class="form-group">
                <label for="compagni_stanza"
                    >Vorrei dormire con (Cognomi):</label
                >
                <textarea id="compagni_stanza" name="compagni_stanza" rows="2"
                ></textarea>
            </div>

            <div class="form-group">
                <label>Porto un animale domestico? *</label>
                <div class="radio-group-row">
                    <label class="radio-container">
                        <input
                            type="radio"
                            name="animale"
                            value="si"
                            required
                        />
                        <span class="radio-mark"></span>
                        Sì
                    </label>
                    <label class="radio-container">
                        <input
                            type="radio"
                            name="animale"
                            value="no"
                            required
                        />
                        <span class="radio-mark"></span>
                        No
                    </label>
                </div>
            </div>
        </div>

        <!-- Step 4: Regolamento -->
        <div class="form-section bg-light">
            <h3 class="form-section-title">4. Regolamento e Privacy</h3>
            <div class="privacy-box">
                <ul>
                    <li>
                        1. Presa visione del regolamento e scadenze pagamenti.
                    </li>
                    <li>2. Possesso certificato medico idoneo.</li>
                    <li>3. Autorizzazione tesseramento ASD.</li>
                    <li>4. Presa visione informativa Privacy.</li>
                    <li>5. Consenso dati sanitari.</li>
                    <li>6. Consenso foto/video.</li>
                    <li>7. Info quote.</li>
                    <li>8. Info extra.</li>
                    <li>9. Politica rimborsi.</li>
                    <li>10. Ricevuta allegata.</li>
                </ul>
            </div>

            <div class="form-group mt-md">
                <label>Accettazione *</label>
                <label class="checkbox-container">
                    <input
                        type="checkbox"
                        name="privacy"
                        value="full"
                        required
                    />
                    <span class="checkmark"></span>
                    Accetto integralmente il regolamento (Punti 1-10)
                </label>
                <label class="checkbox-container">
                    <input type="checkbox" name="privacy" value="daily" />
                    <span class="checkmark"></span>
                    Accetto regolamento giornaliero (Punti 1-6)
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-large mt-md"
            >INVIA ISCRIZIONE</button
        >
    </form>
</div>

<script>
    const tipologiaSelect = document.getElementById("tipologia");
    const infoBox = document.getElementById("tipologia-info");
    const atletaGroup = document.getElementById("atleta-accompagnato-group");
    const atletaInput = document.getElementById("atleta_accompagnato");

    const infoMap = {
        "accompagnatore_0-2": "Gratis",
        "accompagnatore_3-7":
            "Saldo 75,00 € entro il 30 giugno al seguente IBAN: IT07D0843415500000000401347 intestato a ASD KARATE SPORT CENTER",
        "accompagnatore_8+":
            "Saldo 125,00 € entro il 30 giugno al seguente IBAN: IT07D0843415500000000401347 intestato a ASD KARATE SPORT CENTER",
        allievo:
            "Saldo 225,00 € entro il 30 giugno al seguente IBAN: IT07D0843415500000000401347 intestato a ASD KARATE SPORT CENTER",
        tecnico:
            "Saldo 225,00 € entro il 30 giugno al seguente IBAN: IT07D0843415500000000401347 intestato a ASD KARATE SPORT CENTER",
    };

    if (tipologiaSelect) {
        tipologiaSelect.addEventListener("change", (e) => {
            const value = e.target.value;

            // Update Info Text
            if (infoMap[value]) {
                infoBox.textContent = infoMap[value];
                infoBox.classList.remove("hidden");
            } else {
                infoBox.classList.add("hidden");
            }

            // Toggle Atleta Accompagnato Field
            if (value && value.startsWith("accompagnatore")) {
                atletaGroup.classList.remove("hidden");
                atletaInput.setAttribute("required", "required");
            } else {
                atletaGroup.classList.add("hidden");
                atletaInput.removeAttribute("required");
                atletaInput.value = ""; // Reset value
            }
        });
    }
</script>

<style>
    .registration-form-container {
        background: white;
        padding: var(--spacing-lg);
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-top: 5px solid var(--color-blue);
        max-width: 800px;
        margin: 0 auto;
    }

    .form-section {
        margin-bottom: var(--spacing-xl);
        padding-bottom: var(--spacing-lg);
        border-bottom: 1px solid #eee;
    }

    .form-section:last-child {
        border-bottom: none;
    }

    .form-section-title {
        color: var(--color-blue);
        border-left: 4px solid var(--color-orange);
        padding-left: 10px;
        margin-bottom: var(--spacing-md);
    }

    .form-note {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: var(--spacing-md);
        font-style: italic;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--color-text);
    }

    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="date"],
    .form-group input[type="file"],
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-family: var(--font-body);
        font-size: 1rem;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--color-blue);
        outline: none;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
    }

    .row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* Custom Checkbox/Radio */
    .checkbox-container,
    .radio-container {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        cursor: pointer;
        font-weight: 500 !important;
        user-select: none;
    }

    .checkbox-container input,
    .radio-container input {
        display: none;
    }

    .checkmark,
    .radio-mark {
        display: inline-block; /* Ensure dimensions are respected */
        height: 20px;
        width: 20px;
        background-color: #f0f0f0;
        border: 1px solid #ccc; /* Add border for visibility */
        border-radius: 4px;
        margin-right: 12px;
        position: relative;
        flex-shrink: 0;
    }

    .radio-mark {
        border-radius: 50%;
    }

    .checkbox-container:hover .checkmark,
    .radio-container:hover .radio-mark {
        background-color: #ccc;
    }

    .checkbox-container input:checked + .checkmark,
    .radio-container input:checked + .radio-mark {
        background-color: var(--color-blue);
    }

    .checkmark:after,
    .radio-mark:after {
        content: "";
        position: absolute;
        display: none;
    }

    .checkbox-container input:checked + .checkmark:after {
        left: 7px;
        top: 3px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
        display: block;
    }

    .radio-container input:checked + .radio-mark:after {
        top: 6px;
        left: 6px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: white;
        display: block;
    }

    .radio-group-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .checkbox-group-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .bg-light {
        background-color: #f9fafb;
        padding: 20px;
        border-radius: 10px;
    }

    .privacy-box ul {
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 10px;
        padding-left: 20px;
    }

    .mt-md {
        margin-top: var(--spacing-md);
    }

    @media (max-width: 600px) {
        .row-2 {
            grid-template-columns: 1fr;
        }
        .checkbox-group-grid {
            grid-template-columns: 1fr;
        }
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }
    .success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    .error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    .info-box {
        margin-top: 10px;
        padding: 10px;
        background-color: #e3f2fd;
        border: 1px solid #bbdefb;
        color: #0d47a1;
        border-radius: 5px;
        font-size: 0.9rem;
    }
    .hidden {
        display: none !important;
    }
</style>
