---
import galleryData from "../data/gallery.json";

const teaserImages = galleryData.slice(0, 5);
---

<section id="gallery" class="section">
    <div class="container text-center">
        <h2 class="section-title">Gallery</h2>
        <p class="section-subtitle">
            I momenti più belli delle scorse edizioni
        </p>

        <div class="gallery-preview">
            {
                teaserImages.map((image) => (
                    <div
                        class="preview-item"
                        style={`background-image: url('${image.src}')`}
                        title={image.title}
                    />
                ))
            }
        </div>

        <div class="mt-large">
            <a href="/gallery" class="btn btn-primary">Guarda tutte le foto</a>
        </div>
    </div>
</section>

<style>
    .gallery-preview {
        display: flex;
        gap: 10px;
        height: 300px;
        margin-top: var(--spacing-lg);
        overflow: hidden;
        border-radius: 20px;
    }

    .preview-item {
        flex: 1;
        background-size: cover;
        background-position: center;
        transition: flex 0.5s ease;
        cursor: pointer;
    }

    .preview-item:hover {
        flex: 3;
    }

    .mt-large {
        margin-top: var(--spacing-xl);
    }
</style>
